# ============================================================================
# ZenFrame — environment configuration
#
# Two deployment targets:
#   • Local development: SQLite + local uploads + in-memory limiter + dev mail.
#   • Vercel production: Firebase Auth + Postgres (Neon) + Vercel Blob + Upstash
#     Redis. On Vercel the filesystem is ephemeral — nothing persistent may be
#     read from or written to it.
#
# Copy to .env.local for development. NEVER commit real secret values.
# ============================================================================

# ----------------------------------------------------------------------------
# Core (both environments)
# ----------------------------------------------------------------------------

# Canonical production URL. Used for metadataBase, canonicals, sitemap, robots,
# OG images, share links and email action links.
# Local dev: leave unset (falls back to https://zenframe.in in metadata but
# cookies work fine over http://localhost).
# Production: https://zenframe.in  (must be HTTPS — session cookies are Secure)
NEXT_PUBLIC_SITE_URL=https://zenframe.in

# Root of ALL persistent local state (SQLite DB, uploads/, backups/, .mail).
# Local dev: unset → ./data in the project. On Vercel this is unused (Postgres
# + Blob instead) and the startup validator will warn if set to a temp path.
# ZENFRAME_DATA_DIR=/persistent/path

# ----------------------------------------------------------------------------
# Firebase Authentication — client (public, safe in the browser bundle)
# ----------------------------------------------------------------------------
# Firebase web API keys are identifiers, not secrets. Access control happens
# server-side: every protected request verifies the Firebase ID token with the
# Admin SDK, and identity is derived ONLY from the verified token.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=zenframe.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=zenframe
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# Firebase Authentication — server (Admin SDK, NEVER exposed to the client)
# ----------------------------------------------------------------------------
# From Firebase Console → Project settings → Service accounts → Generate new
# private key. Put the key's actual newlines as \n escapes in a single line.
# Used to verify Firebase ID tokens server-side (revocation-aware).

FIREBASE_PROJECT_ID=zenframe
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@zenframe.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Local dev: unset → SQLite at ZENFRAME_DATA_DIR/zenframe.db (node:sqlite).
# Production (Vercel): set DATABASE_URL to a managed Postgres (Neon pooled
# connection) and apply db/schema-postgres.sql:
#   psql "$DATABASE_URL" -f db/schema-postgres.sql
# SQLite on the Vercel function filesystem is EPHEMERAL — never production.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# STORAGE_DRIVER=local  → development: files under ZENFRAME_DATA_DIR/uploads.
# STORAGE_DRIVER=blob   → production: Vercel Blob (private objects; bytes are
#                         served only through ZenFrame's authorization-checked
#                         routes, never public blob URLs).
STORAGE_DRIVER=local

# Injected automatically by Vercel when a Blob store is connected to the
# project. Never commit it.
# BLOB_READ_WRITE_TOKEN=

# ----------------------------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------------------------
# In-memory limiter works for a single instance / local dev. For multi-instance
# production set RATE_LIMIT_DRIVER=redis + Upstash credentials. Redis only
# coordinates the rate limiter — it does NOT make SQLite multi-instance safe.
RATE_LIMIT_DRIVER=memory

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----------------------------------------------------------------------------
# Email (password-mode only)
# ----------------------------------------------------------------------------
# In Firebase mode, verification + password-reset emails are sent by Firebase
# Auth itself (templates configured in the Firebase Console) — ZenFrame's mailer
# is unused. Keep this section for password-mode/local development.
#
# RESEND_API_KEY=                      # preferred provider
# SMTP_HOST=                           # optional SMTP fallback
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false                    # true = implicit TLS on port 465
# MAIL_FROM="ZenFrame <hello@zenframe.in>"

# Development mail logging: writes links to data/.mail instead of sending.
# Development convenience only — MUST stay unset in production.
# ALLOW_DEV_MAIL_LOG=

# ----------------------------------------------------------------------------
# Analytics (optional, privacy-conscious, server-side)
# ----------------------------------------------------------------------------
ANALYTICS_PROVIDER=
ANALYTICS_ENDPOINT=
ANALYTICS_TOKEN=
